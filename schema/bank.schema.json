{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quiz-ledger/bank@1",
  "title": "Quiz Ledger question bank",
  "type": "object",
  "required": ["schema", "id", "course", "units", "questions"],
  "properties": {
    "schema": { "const": "quiz-ledger/bank@1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Globally unique slug, e.g. statx303-2026s2. Attempt data is keyed on it." },
    "course": {
      "type": "object",
      "required": ["code", "title"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "institution": { "type": "string" },
        "language": { "type": "object", "properties": { "question": { "type": "string" }, "explanation": { "type": "string" } } }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "version": { "type": "string" }, "updated": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string" }, "note": { "type": "string" }
      }
    },
    "figure_preamble": { "type": "string", "description": "LaTeX preamble for figures, up to but excluding \\begin{document}." },
    "units": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "group": { "type": "string" }
        }
      }
    },
    "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "description": "Plain text with $...$ / $$...$$ math." },
    "options": {
      "type": "array", "minItems": 2,
      "items": { "type": "object", "required": ["label", "text"], "properties": { "label": { "type": "string", "minLength": 1 }, "text": { "$ref": "#/$defs/text" } } }
    },
    "figure": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "required": ["latex"],
          "properties": {
            "id": { "type": "string", "description": "Optional. Questions sharing a figure use the same id; it is compiled once." },
            "latex": { "type": "string", "minLength": 1, "description": "A tikzpicture (or any body) compiled with figure_preamble." },
            "caption": { "type": "string" }
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "required": ["id", "type", "unit", "question", "answer"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "description": "Unique within the bank; keep it stable." },
        "type": { "enum": ["true_false", "single_choice", "multiple_choice", "fill_blank"] },
        "unit": { "type": "string", "description": "id of an entry in units." },
        "section": { "type": "string" },
        "topic": { "type": "string" },
        "difficulty": { "enum": [1, 2, 3] },
        "question": { "$ref": "#/$defs/text" },
        "explanation": { "type": "string" },
        "figure": { "$ref": "#/$defs/figure" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "true_false" } } }, "then": { "properties": { "answer": { "type": "boolean" } } } },
        { "if": { "properties": { "type": { "const": "single_choice" } } }, "then": { "required": ["options"], "properties": { "options": { "$ref": "#/$defs/options" }, "answer": { "type": "string", "description": "Label of the correct option." } } } },
        { "if": { "properties": { "type": { "const": "multiple_choice" } } }, "then": { "required": ["options"], "properties": { "options": { "$ref": "#/$defs/options" }, "answer": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } } } } },
        { "if": { "properties": { "type": { "const": "fill_blank" } } }, "then": { "properties": {
            "question": { "pattern": "_{4,}", "description": "Mark each blank with four or more underscores." },
            "answer": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "One reference answer per blank." },
            "accept": { "type": "array", "items": { "type": "array", "items": { "type": "string" } }, "description": "Optional further accepted forms, one array per blank." } } } }
      ]
    }
  }
}
